# Template for the project-local credential file.
#
#   cp .env.example .env.local
#
# The filename matters: every tool in this repo reads `.env.local` from the
# repository root and nothing reads a bare `.env`. Both are gitignored — this
# template is the only one of the three that is committed. Never fill this file
# in directly, and never paste a real key into any tracked file.
#
# Node scripts resolve, in order: $ACS_ENV, ./.env.local, <repo>/.env.local.
# The enrichment CLI reads <workspace>/.env.local, where --workspace is the repo root.
#
# Values are read, used, and never printed. The enrichment CLI passes them to
# curl through stdin rather than argv, because argv is world-readable and a
# corpus run spawns one curl per page.


# ---------------------------------------------------------------------------
# Algolia core
# ---------------------------------------------------------------------------

# The only permitted app (docs/design/search-experience/discovery-engagement/OPERATING-CONTRACT.md).
ALGOLIA_APP_ID=0EXRPAXB56

# Mutations: agents/admin/ agent create+patch, and every enrichment write.
# This key can rewrite indices and agent configuration. It is server-side only —
# it must never appear in widget markup, a browser bundle, or a committed file.
ALGOLIA_ADMIN_API_KEY=

# Read-only. Used by agents/checks/ so live spot-checks travel the same wire path
# as the browser. This is also the key class the chat widget takes as its
# `search-api-key` attribute.
ALGOLIA_SEARCH_API_KEY=

# Optional. Only `algolia_enrichment/api.py` reads it, as a fallback when
# ALGOLIA_ADMIN_API_KEY is unset. Leave empty if you set the admin key above.
ALGOLIA_WRITE_API_KEY=


# ---------------------------------------------------------------------------
# Agent Studio provisioning — agents/admin/build_algolia_com_agents.mjs
# ---------------------------------------------------------------------------

# Optional. Set it to use the shared Algolia-Central inference provider.
# When empty, the build script clones the provider and model from a live agent
# on this app instead, and prints which path it took.
ALGOLIA_PROVIDER_INFERENCE_ID=

# Optional. Only consulted when ALGOLIA_PROVIDER_INFERENCE_ID is set. Defaults to `medium`.
ALGOLIA_INFERENCE_MODEL=


# ---------------------------------------------------------------------------
# Compare-with-production harness — frontend/chat-widget/proxy.mjs
# ---------------------------------------------------------------------------
#
# The live algolia.com Ask AI agent, used as the production side of the compare
# toggle. This is a DIFFERENT application from the one above (0EXRPAXB56). Its
# search key is already public — it ships in algolia.com's own page source — but
# it still lives here, not inline in any HTML, so no key sits in a tracked file.
#
# The proxy reads these and injects `Origin: https://www.algolia.com` because
# Agent Studio's per-agent approved-domains list rejects other origins. That is
# a lightweight abuse control on the org's own infrastructure, exercised
# read-only for comparison; see the plan's authorization-basis section.
PROD_ASKAI_APP_ID=1QDAWL72TQ
PROD_ASKAI_SEARCH_KEY=
PROD_ASKAI_AGENT_ID=ebff018c-66e1-44df-b33a-2a58a0188840


# ---------------------------------------------------------------------------
# Corpus enrichment — skills/algolia-data-enrichment/
# ---------------------------------------------------------------------------

# Scout is the ONLY permitted page-body source. No curl, no WebFetch, no .md twin,
# no fallback — the grounding invariant depends on every span being sliced from a
# Scout-fetched body. `fetch` refuses to run without this.
SCOUT_HOSTED_API_KEY=

# Optional. scripts/enrichment-config.yaml already pins the hosted base URL
# (https://scout.chowmes.com); this env var is only a fallback when that is unset.
SCOUT_BASE_URL=

# Writer and judge models. Required by `enrich`, `repair`, and the judge pass.
# The served model string is asserted at run start against enrichment-config.yaml,
# so re-pointing this endpoint fails loudly instead of silently changing what
# graded the corpus.
ALGOLIA_INFERENCE_BASE_URL=
ALGOLIA_INFERENCE_API_KEY=


# ---------------------------------------------------------------------------
# Search-first demo — frontend/search-first-demo/build_index.py
# ---------------------------------------------------------------------------

# Optional. Defaults to SEARCHFIRST_WWW_v1. This is the prototype's own index,
# not a retrieval index the concierge reads.
DEMO_INDEX=


# ---------------------------------------------------------------------------
# Not set here
# ---------------------------------------------------------------------------
#
# Shell-only, per invocation — do not add them to .env.local:
#   ACS_ENV                    override the env-file path for the Node scripts
#   ALGOLIA_COM_AGENT_SUFFIX   dry-run suffix, e.g. `-dev`, so a test run never
#                              touches live agent names
#
# Separate gitignored files, each with its own single secret:
#   .env.asana                 Asana PAT
#   .env.vps                   VPS connection parameters
#
# The chat widget takes NO environment variables at runtime. Its app id, search
# key, index, and agent ids are HTML attributes on <algolia-chat>
# (`app-id`, `search-api-key`, `index-name`, `agents`), set in the Jahia
# custom-code block. The VITE_* build-time fallbacks compiled into the bundle
# belong to the widget's own repository, smomin/algolia-central-chat-widget,
# not to this one.
