{
  "name": "algolia-chat-stack",
  "description": "Manifest for the Jahia chat widget assets and Agent Studio orchestrator prompts deployed to the Algolia.com development surface.",
  "environment": {
    "algoliaAppIdEnv": "ALGOLIA_APP_ID",
    "algoliaAdminApiKeyEnv": "ALGOLIA_ADMIN_API_KEY",
    "algoliaSearchApiKeyEnv": "ALGOLIA_SEARCH_API_KEY"
  },
  "jahia": {
    "deployScript": "tools/deployment/deploy_jahia_engagement_tracker.py",
    "liveUrl": "https://tmp-content-eng-algolia.cloud.jahia.com/?algoliaChatDebug=1&algoliaProactiveDebug=1",
    "requiredLiveMarkers": [
      "algolia-chat-theme-algolia-modal-greeting-width-20260815a.js",
      "algolia-chat.js",
      "algolia-engagement-tracker.js",
      "algolia-context-compiler",
      "algolia-proactive-controller.js",
      "handoff-to-orchestrator",
      "algolia-chat-engage.js",
      "algolia-chat-compare.js",
      "token-telemetry.js"
    ],
    "compareWithProduction": {
      "script": "frontend/chat-widget/algolia-chat-compare.js",
      "deploymentTool": "tools/deployment/deploy_compare_integration_jahia.py",
      "immutableReleaseAssets": [
        "handoff-to-orchestrator-compare-<content-sha12>.js",
        "algolia-chat-compare-<content-sha12>.js"
      ],
      "preservedRuntimeAssets": [
        "algolia-context-compiler.js",
        "token-telemetry.js"
      ],
      "productionAgent": {
        "appId": "1QDAWL72TQ",
        "agentId": "ebff018c-66e1-44df-b33a-2a58a0188840",
        "index": "ALGOLIA_WWW_PROD_V2",
        "apiKeyEnv": "PROD_ASKAI_API_KEY",
        "legacySearchKeyEnv": "PROD_ASKAI_SEARCH_KEY",
        "note": "Controlled same-input benchmark. Both agents receive the identical finalized body, including current session and page context. The Jahia deployer preserves the already-working live window.ACS_COMPARE config by default; the API key env is required only when intentionally creating or replacing that config. Before deployment, record verification that the browser key is read-only, correctly scoped, monitored, and revocable; no proxy is deployed on Jahia."
      }
    },
    "tokenTelemetry": {
      "script": "frontend/chat-widget/token-telemetry.js",
      "backendModule": "backend/jahia-modules/algolia-token-telemetry",
      "browserDeploymentTool": "tools/deployment/deploy_compare_integration_jahia.py",
      "actionPath": "/sites/algolia-assets/home.algoliaTokenTelemetry.do",
      "note": "Install and configure the backend module first using Jahia's supported Provisioning or module-management API. Browser cutover is then gated by a live read-only token lookup. Primary token usage observes completed calls from the sole orchestrator transport; the browser sends only conversationId, and the Jahia module fixes the app and agent and returns token totals only."
    }
  },
  "agentStudio": {
    "greetings": {
      "agentId": "0f290529-629a-48fe-9424-f93e5894d8f3",
      "name": "www Chat - Proactive Concierge",
      "instructionsPath": "agents/prompts/instructions_algolia_proactive_greeting.md",
      "systemPromptPath": "agents/prompts/system_algolia_arrie_concierge.md",
      "configPatch": {
        "temperature": 0.5
      },
      "toolsPolicy": "empty",
      "evidenceRoot": "docs/evidence/agent-studio"
    },
    "orchestrator": {
      "agentId": "e2c8596a-4420-41d2-80bb-5cd4aaeffda6",
      "name": "www Chat - Orchestrator",
      "instructionsPath": "agents/prompts/instructions_algolia_orchestrator.md",
      "systemPromptPath": "agents/prompts/system_algolia_orchestrator.md",
      "searchToolPatch": {
        "toolName": "algolia_search_index",
        "indexName": "Algolia_Prod_Copy_Vanilla",
        "searchParameters": {
          "filters": "environment:\"prod20260722\" AND language_code:\"en\" AND NOT is404:true",
          "hitsPerPage": null,
          "attributesToRetrieve": null,
          "attributesToSnippet": null
        }
      },
      "evidenceRoot": "docs/evidence/agent-studio",
      "specialists": [
        {
          "key": "evidence",
          "agentId": "c735a57d-d64e-4c4f-bea2-857a608d5a52",
          "name": "Customer Evidence Specialist"
        },
        {
          "key": "product",
          "agentId": "24b23e23-26a6-4f98-9019-44746e1eb7f0",
          "name": "Product Specialist"
        },
        {
          "key": "tech",
          "agentId": "cdac8765-5626-451a-87a0-f5a95aad7235",
          "name": "Developer Specialist"
        },
        {
          "key": "sales",
          "agentId": "6e388624-2b08-4c70-8175-525612b7670a",
          "name": "Sales Concierge"
        }
      ]
    },
    "developerSpecialist": {
      "agentId": "cdac8765-5626-451a-87a0-f5a95aad7235",
      "name": "www Chat – Developer Specialist",
      "instructionsPath": "agents/prompts/instructions_algolia_developer_specialist.md",
      "systemPromptPath": "agents/prompts/system_algolia_developer_specialist.md",
      "evidenceRoot": "docs/evidence/agent-studio"
    }
  }
}
