{
  "setChatFile": {
    "data": {
      "jcr": {
        "file": {
          "content": {
            "data": {
              "setValue": true
            },
            "mime": {
              "setValue": true
            },
            "node": {
              "path": "/sites/www/files/algolia-chat.js/jcr:content"
            }
          },
          "node": {
            "path": "/sites/www/files/algolia-chat.js"
          }
        }
      }
    }
  },
  "setBlockHtml": {
    "data": {
      "jcr": {
        "block": {
          "html": {
            "setValue": true
          },
          "node": {
            "path": "/sites/www/home/drift/custom-code-block"
          }
        }
      }
    }
  },
  "publishChat": {
    "data": {
      "jcr": {
        "target": {
          "publish": true,
          "node": {
            "path": "/sites/www/files/algolia-chat.js"
          }
        }
      }
    }
  },
  "publishFilesSubtree": {
    "data": {
      "jcr": {
        "target": {
          "publish": true,
          "node": {
            "path": "/sites/www/files"
          }
        }
      }
    }
  },
  "publishDriftSubtree": {
    "data": {
      "jcr": {
        "target": {
          "publish": true,
          "node": {
            "path": "/sites/www/home/drift"
          }
        }
      }
    }
  },
  "versionBlock": {
    "data": {
      "jcr": {
        "block": {
          "createVersion": true,
          "node": {
            "path": "/sites/www/home/drift/custom-code-block"
          }
        }
      }
    }
  },
  "publishBlock": {
    "data": {
      "jcr": {
        "target": {
          "publish": true,
          "node": {
            "path": "/sites/www/home/drift/custom-code-block"
          }
        }
      }
    }
  }
}
