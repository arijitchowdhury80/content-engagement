{
  "updateFile": {
    "data": {
      "jcr": {
        "file": {
          "content": {
            "data": {
              "setValue": true
            },
            "mime": {
              "setValue": true
            },
            "node": {
              "path": "/sites/www/files/algolia-chat.js/jcr:content"
            }
          },
          "node": {
            "path": "/sites/www/files/algolia-chat.js"
          }
        }
      }
    }
  },
  "setBlockHtml": {
    "skipped": "already had release"
  },
  "publishFile": {
    "data": {
      "jcr": {
        "target": {
          "publish": true,
          "node": {
            "path": "/sites/www/files/algolia-chat.js"
          }
        }
      }
    }
  },
  "publishFiles": {
    "data": {
      "jcr": {
        "target": {
          "publish": true,
          "node": {
            "path": "/sites/www/files"
          }
        }
      }
    }
  },
  "publishBlock": {
    "data": {
      "jcr": {
        "target": {
          "publish": true,
          "node": {
            "path": "/sites/www/home/drift/custom-code-block"
          }
        }
      }
    }
  },
  "publishDrift": {
    "data": {
      "jcr": {
        "target": {
