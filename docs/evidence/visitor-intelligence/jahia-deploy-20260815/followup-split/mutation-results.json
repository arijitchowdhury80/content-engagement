{
  "deployData": {
    "jcr": {
      "setChatFile": {
        "content": {
          "data": {
            "setValue": true
          },
          "mime": {
            "setValue": true
          },
          "node": {
            "path": "/sites/www/files/algolia-chat.js/jcr:content"
          }
        },
        "node": {
          "path": "/sites/www/files/algolia-chat.js"
        }
      },
      "setBlockHtml": {
        "html": {
          "setValue": true
        },
        "node": {
          "path": "/sites/www/home/drift/custom-code-block"
        }
      }
    }
  },
  "publishData": {
    "jcr": {
      "publishChat": {
        "publish": true,
        "node": {
          "path": "/sites/www/files/algolia-chat.js"
        }
      },
      "publishFilesSubtree": {
        "publish": true,
        "node": {
          "path": "/sites/www/files"
        }
      },
      "publishDriftSubtree": {
        "publish": true,
        "node": {
          "path": "/sites/www/home/drift"
        }
      },
      "versionBlock": {
        "createVersion": true,
        "node": {
          "path": "/sites/www/home/drift/custom-code-block"
        }
      },
      "publishBlock": {
        "publish": true,
        "node": {
          "path": "/sites/www/home/drift/custom-code-block"
        }
      }
    }
  }
}