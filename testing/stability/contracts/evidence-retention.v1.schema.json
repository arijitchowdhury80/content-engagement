{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EvidenceRetention.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rawRoot", "rawCaptureEnabled", "retentionDays", "deleteAfter", "incidentExtension"],
  "properties": {
    "schema": { "const": "EvidenceRetention.v1" },
    "rawRoot": { "type": "string", "minLength": 1 },
    "rawCaptureEnabled": { "type": "boolean" },
    "retentionDays": { "type": "integer", "minimum": 1, "maximum": 30, "default": 7 },
    "deleteAfter": { "type": "string", "format": "date-time" },
    "incidentExtension": { "type": ["object", "null"] }
  }
}
