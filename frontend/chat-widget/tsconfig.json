{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@algolia-central/chat-central": ["source/algolia-com/code/runtime/index.ts"]
    }
  },
  "include": ["source/**/*.ts", "source/**/*.tsx", "vite.config.ts", "build/**/*.mjs"],
  "exclude": ["source/**/*.test.ts", "source/**/*.test.tsx"]
}
