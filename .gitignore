# credentials — symlink to commons/rendered/*.env, never commit
.env.local
.env
*.env

.DS_Store
node_modules/
.playwright-mcp/

# raw crawl / enrichment data payloads — regenerable, too large for git, not "docs"
docs/50-prototype/corpus/records.jsonl
docs/50-prototype/corpus/records-doc.jsonl
# These said `docs/60-enrichment/` until 2026-08-07. That directory was renamed to
# 70-enrichment long before, so both rules matched nothing and 23MB of payload
# (enhanced-pre-taxonomy 18MB, taxonomy-assignments 4.2MB) was committed to this PUBLIC
# repo against the intent stated one line above. Same rename that renumbered the work units.
# Duplicated in docs/70-enrichment/.gitignore so a future rename cannot orphan them again.
docs/70-enrichment/enhanced-pre-taxonomy-*.jsonl
docs/70-enrichment/taxonomy-assignments.jsonl
docs/70-enrichment/snapshots/
docs/70-enrichment/work-queue.jsonl
docs/70-enrichment/cache*/

# full Agent Studio agent dump — contains complete internal system-prompt text for 51
