# credentials — symlink to commons/rendered/*.env, never commit
.env.local
.env
*.env

.DS_Store
**/.DS_Store
**/__pycache__/
**/.pytest_cache/
node_modules/
.playwright-mcp/
testing/team-uat/.artifacts/
docs/evidence/visitor-intelligence/**/*-network.json

# raw crawl / enrichment data payloads — regenerable, too large for git, not "docs"
frontend/search-first-demo/corpus/records.jsonl
frontend/search-first-demo/corpus/records-doc.jsonl
# These said `docs/60-enrichment/` until 2026-08-07. That directory was renamed to
# 70-enrichment long before, so both rules matched nothing and 23MB of payload
# (enhanced-pre-taxonomy 18MB, taxonomy-assignments 4.2MB) was committed to this PUBLIC
# repo against the intent stated one line above. Same rename that renumbered the work units.
# Duplicated in docs/operations/enrichment/.gitignore so a future rename cannot orphan them again.
docs/operations/enrichment/enhanced-pre-taxonomy-*.jsonl
docs/operations/enrichment/taxonomy-assignments.jsonl
docs/operations/enrichment/snapshots/
docs/operations/enrichment/runs/
docs/operations/enrichment/quarantine/
docs/operations/enrichment/work-queue.jsonl
docs/operations/enrichment/cache*/

# full Agent Studio agent dump — contains complete internal system-prompt text for 51
# live agents; this repo is public, do not ship internal prompt content by default
docs/research/search-experience/agent-studio-inventory.json
docs/research/search-experience/workstream-1-agent-studio-*.json
docs/research/search-experience/workstream-1-completion-smoke-stream.txt

# Asana PAT — project-local, never commit
.env.asana

# VPS connection params — project-local, never commit
.env.vps

# Skill build residue — pattern, not instances (see docs/operations/enrichment/.gitignore for why)
skills/*/scripts/**/__pycache__/
skills/*/.pytest_cache/

# Local execution state. These files support a developer session but are not project source,
# customer evidence, or safe public GitHub content.
.planning/
.development-loop/
.tmp-jahia-upload/
.pytest_cache/
SESSION.md

# Local widget harness. Hosts the chat custom elements against live Agent Studio for
# local development. Pattern, not a single filename, so a rename cannot orphan the rule
# (see the enhanced-pre-taxonomy incident above for why that matters). Any *.local.html
# under chat-widget is a developer scratch surface, never the Jahia deployment source.
frontend/chat-widget/*.local.html

# Regenerable local analysis and enrichment residue.
docs/research/search-experience/.cache-enhanced-census.jsonl
docs/operations/enrichment/.selection-registry.jsonl.lock
docs/operations/enrichment/_archive/
production_comparison/runs/
.local/deployment-state/
